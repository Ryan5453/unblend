# The .dockerignore file excludes files from the container build process.
#
# https://docs.docker.com/engine/reference/builder/#dockerignore-file

# Exclude Git files
.git
.github
.gitignore

# Exclude Python cache files
**/__pycache__
.mypy_cache
.pytest_cache
.ruff_cache

# Exclude Python virtual environment
/venv
.venv

# Exclude JS / web sources (not part of the Cog build)
node_modules
web/

# Exclude tests
tests/

# Exclude macOS metadata
**/.DS_Store

# Exclude ONNX exports (e.g. htdemucs_fp16.onnx)
*.onnx
*.onnx.data
**/*.onnx
**/*.onnx.data

# Exclude benchmark output directories
benchmarks/
/musdb_*/
/upstream_*/
/dt_*/

# Exclude local environments, build output and working notes
.upstream-venv/
dist/
.idea/
.claude
BENCHMARK.md
SLURM_HANDOFF.md
TODO.md
FIXES.md
separated/
*.profraw
